AIRHOST_CACHE_MAX_AGE_MS=900000

# GMO Sign
# Keep the existing free account. No GMO Sign API credentials are required.
# Monthly contract packets are prepared automatically and then sent manually in the GMO Sign UI.

# Runtime
GTOS_PUBLIC_BASE_URL=

# Group Trip OS live integration
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-09-16

# AirHost local cache/webhook integration
AIRHOST_API_BASE_URL=
AIRHOST_API_TOKEN=

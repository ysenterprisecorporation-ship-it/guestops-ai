# 未確認値は空欄。既存値をそのまま転記し、URLや価格は変更しない。
# GASはこのファイルを読まない。export:properties→Script Propertiesへ設定する。
A_URL=
P3_URL=
P10_URL=
UPGRADE_P3_URL=
UPGRADE_P10_URL=
SITE_URL=
DRIVE_A=
DRIVE_P3=
DRIVE_P10=
DRIVE_A_URL=
DRIVE_P3_URL=
DRIVE_P10_URL=
VARIATION_A=
VARIATION_P3=
VARIATION_P10=
VARIATION_UPGRADE_P3=
VARIATION_UPGRADE_P10=
# 秘密値。GitHub/ソースへ保存しない。
SQUARE_ACCESS_TOKEN=
SQUARE_API_VERSION=
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=
SQUARE_MERCHANT_ID=
SPREADSHEET_ID=
ADMIN_EMAIL=
WEBHOOK_URL_SECRET=
# 会話で選択済みの方式。署名検証は行わない。
ACKNOWLEDGE_UNSIGNED_WEBHOOK=true
# 初期停止。受入確認時だけGASのプロパティで有効化する。
AUTOMATION_ENABLED=false
# 新規GASのID。GASの実行設定へは送らない。
GAS_SCRIPT_ID=

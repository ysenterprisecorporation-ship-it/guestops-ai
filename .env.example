# 未確認値は空欄。既存値をそのまま転記し、URLや価格は変更しない。
# GASはこのファイルを読まない。export:properties→Script Propertiesへ設定する。
A_URL=
P3_URL=
P10_URL=
UPGRADE_P3_URL=
UPGRADE_P10_URL=
SITE_URL=
DRIVE_A=
DRIVE_P3=
DRIVE_P10=
DRIVE_A_URL=
DRIVE_P3_URL=
DRIVE_P10_URL=
VARIATION_A=
VARIATION_P3=
VARIATION_P10=
VARIATION_UPGRADE_P3=
VARIATION_UPGRADE_P10=
# 秘密値。GitHub/ソースへ保存しない。
SQUARE_ACCESS_TOKEN=
SQUARE_API_VERSION=
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=
SQUARE_MERCHANT_ID=
SPREADSHEET_ID=
ADMIN_EMAIL=
RELAY_SHARED_SECRET=
# Square新規Webhook購読の署名鍵。APIアクセストークンとは異なる。
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
# 購入者メールは受入試験時にtrueへ。返信先はADMIN_EMAIL。
BUYER_EMAIL_ENABLED=false
# 初期停止。受入確認時だけGASのプロパティで有効化する。
AUTOMATION_ENABLED=false
# 新規GASのID。GASの実行設定へは送らない。
GAS_SCRIPT_ID=

# 新規GASの公開/exec URL（既存販売URLではない）
GAS_WEB_APP_URL=
# 署名検証受信口：設定完了後だけtrue
RECEIVER_ENABLED=false
